# Supabase project (server-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same project, exposed to the browser for the Auth SDK (sign in/up/out)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Envelope-encryption key for BYOK provider keys + Vercel OAuth tokens.
# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every existing encrypted row undecryptable — treat
# it like a database credential, not an app config value.
ENCRYPTION_KEY=

# This app's own public URL — used for the CSRF Origin check on every
# non-GET request (src/start.ts) and to build the Vercel OAuth redirect_uri.
# e.g. https://your-app.vercel.app (no trailing slash).
APP_ORIGIN=

# Vercel OAuth app (Project Settings -> Integrations, or the Integrations
# Console, on vercel.com) — needed for "Connect Vercel" / Publish.
# Set the app's redirect URI to ${APP_ORIGIN}/api/vercel/oauth/callback.
# NOTE: these deliberately do NOT start with "VERCEL_" — Vercel's own
# dashboard rejects any custom env var whose name starts with that prefix
# ("Environment variable ... is invalid") since it reserves the whole
# prefix for its own system variables.
OAUTH_VERCEL_CLIENT_ID=
OAUTH_VERCEL_CLIENT_SECRET=

# Dodo Payments — the one-time Pro unlock ($19, see src/config/plans.ts).
# DODO_ENVIRONMENT: "test_mode" (default) or "live_mode".
# DODO_PRODUCT_ID_PRO: create one product in the Dodo dashboard (one-time
#   price, NOT recurring) and paste its id here (looks like "pdt_...").
# DODO_WEBHOOK_SECRET: register a webhook endpoint at
#   ${APP_ORIGIN}/api/webhooks/dodo in the Dodo dashboard; paste the signing
#   secret it gives you (looks like "whsec_...").
DODO_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID_PRO=
DODO_WEBHOOK_SECRET=

# Pre-launch GTM toggle. "live" (default) shows real sign-up CTAs.
# "waitlist" swaps every CTA on the landing page for an email-capture
# form instead — flip this and redeploy when you're not ready for real
# signups yet. Client-visible (VITE_-prefixed) since it's just UI, not
# sensitive.
VITE_LAUNCH_MODE=live

# Waitlist signups go to a Google Sheet via a Google Apps Script Web App
# (POST endpoint), not Supabase — see README "Waitlist setup" for the
# script to paste in. WAITLIST_WEBHOOK_SECRET is checked inside that
# script so only this app can write rows to it.
WAITLIST_WEBHOOK_URL=
WAITLIST_WEBHOOK_SECRET=
